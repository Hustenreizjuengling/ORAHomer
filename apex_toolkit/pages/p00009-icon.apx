page 9 (
    name: Icon
    alias: ICON
    title: ORAHomer - Icon
    pageGroup: @administration
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region icform (
        name: Icon
        type: form
        source {
            location: localDatabase
            tableName: HOM_ICONS
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
        }
    )

    pageItem P9_ICON_ID (
        type: hidden
        layout {
            sequence: 5
            region: @icform
            slot: regionBody
        }
        source {
            formRegion: @icform
            column: ICON_ID
            dataType: number
            primaryKey: true
        }
    )

    pageItem P9_NAME (
        type: textField
        label {
            label: Name
        }
        layout {
            sequence: 10
            region: @icform
            slot: regionBody
        }
        appearance {
            template: @/required-floating
        }
        validation {
            valueRequired: true
            maxLength: 100
        }
        source {
            formRegion: @icform
            column: NAME
            dataType: varchar2
        }
    )

    pageItem P9_FILE (
        type: fileUpload
        label {
            label: Bilddatei
        }
        layout {
            sequence: 20
            region: @icform
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
        }
        source {
            formRegion: @icform
            column: ICON_BLOB
            dataType: blob
        }
        help {
            helpText: PNG, SVG oder JPG. Beim Bearbeiten leer lassen, um das vorhandene Bild zu behalten.
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Zurück zur Bibliothek
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 8
            }
        }
    )

    button delete (
        buttonName: DELETE
        label: Löschen
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: #DEFAULT#
        }
        behavior {
            action: submitPage
            databaseAction: delete
            requiresConfirmation: true
            warnOnUnsavedChanges: doNotCheck
        }
        confirmation {
            message: Dieses Icon wirklich löschen? Apps/Links, die es nutzen, fallen auf ihr automatisches Icon zurück.
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P9_ICON_ID
        }
    )

    button create (
        buttonName: CREATE
        label: Erstellen
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: submitPage
            databaseAction: insert
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNull
            item: P9_ICON_ID
        }
    )

    button apply-changes (
        buttonName: SAVE
        label: Speichern
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: submitPage
            databaseAction: update
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P9_ICON_ID
        }
    )

    process form-init (
        name: Formular initialisieren
        type: formInitialization
        formRegion: @icform
        execution {
            sequence: 10
            point: afterHeader
        }
    )

    process form-dml (
        name: Formular verarbeiten
        type: formAutoRowProcessing
        formRegion: @icform
        execution {
            sequence: 20
        }
    )

)
