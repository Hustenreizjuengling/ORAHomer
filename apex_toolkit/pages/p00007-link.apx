page 7 (
    name: Link
    alias: LINK
    title: ORAHomer - Externer Link
    pageGroup: @administration
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region lnk (
        name: Link
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
    )

    pageItem P7_LINK_ID (
        type: hidden
        layout {
            sequence: 5
            region: @lnk
            slot: regionBody
        }
    )

    pageItem P7_TITLE (
        type: textField
        label {
            label: Titel
        }
        layout {
            sequence: 10
            region: @lnk
            slot: regionBody
        }
        appearance {
            template: @/required-floating
        }
        validation {
            valueRequired: true
            maxLength: 255
        }
    )

    pageItem P7_URL (
        type: textField
        label {
            label: URL
        }
        layout {
            sequence: 20
            region: @lnk
            slot: regionBody
        }
        appearance {
            template: @/required-floating
            valuePlaceholder: https://...
            icon: fa-link
        }
        validation {
            valueRequired: true
            maxLength: 4000
        }
    )

    pageItem P7_DESCRIPTION (
        type: textField
        label {
            label: Beschreibung (optional)
        }
        layout {
            sequence: 30
            region: @lnk
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
        }
        validation {
            maxLength: 400
        }
    )

    pageItem P7_CATEGORY_ID (
        type: selectList
        label {
            label: Kategorie
        }
        layout {
            sequence: 40
            region: @lnk
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select name as d, category_id as r
                  from hom_categories
                 where is_active = 'Y'
                 order by display_seq, name
                ```
            displayNullValue: true
        }
    )

    pageItem P7_ICON_ID (
        type: selectList
        label {
            label: Icon
        }
        layout {
            sequence: 50
            region: @lnk
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select name as d, icon_id as r
                  from hom_icons
                 order by name
                ```
            displayNullValue: true
        }
    )

    pageItem P7_OPEN_IN_NEW_TAB (
        type: selectList
        label {
            label: In neuem Tab öffnen
        }
        layout {
            sequence: 60
            region: @lnk
            slot: regionBody
        }
        appearance {
            template: @/required-floating
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select 'Ja'   as d, 'Y' as r from dual
                union all
                select 'Nein' as d, 'N' as r from dual
                ```
            displayNullValue: false
        }
    )

    pageItem P7_IS_VISIBLE (
        type: selectList
        label {
            label: Sichtbar
        }
        layout {
            sequence: 70
            region: @lnk
            slot: regionBody
            startNewRow: false
        }
        appearance {
            template: @/required-floating
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select 'Sichtbar'  as d, 'Y' as r from dual
                union all
                select 'Versteckt' as d, 'N' as r from dual
                ```
            displayNullValue: false
        }
    )

    pageItem P7_DISPLAY_SEQ (
        type: numberField
        label {
            label: Reihenfolge
        }
        layout {
            sequence: 80
            region: @lnk
            slot: regionBody
            startNewRow: false
        }
        appearance {
            template: @/optional-floating
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Abbrechen
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 6
            }
        }
    )

    button delete (
        buttonName: DELETE
        label: Löschen
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P7_LINK_ID
        }
    )

    button save (
        buttonName: SAVE
        label: Speichern
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    process load-link (
        name: Load link
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  if :P7_LINK_ID is not null then
                    select title, url, description, category_id, icon_id,
                           open_in_new_tab, is_visible, display_seq
                      into :P7_TITLE, :P7_URL, :P7_DESCRIPTION, :P7_CATEGORY_ID, :P7_ICON_ID,
                           :P7_OPEN_IN_NEW_TAB, :P7_IS_VISIBLE, :P7_DISPLAY_SEQ
                      from hom_links
                     where link_id = :P7_LINK_ID;
                  else
                    :P7_OPEN_IN_NEW_TAB := 'Y';
                    :P7_IS_VISIBLE      := 'Y';
                    :P7_DISPLAY_SEQ     := 10;
                  end if;
                end;
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
    )

    dynamicAction da-save (
        name: Save link
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @save
        }

        action do-save (
            action: executeServerSideCode
            settings {
                itemsToSubmit: P7_LINK_ID,P7_TITLE,P7_URL,P7_DESCRIPTION,P7_CATEGORY_ID,P7_ICON_ID,P7_OPEN_IN_NEW_TAB,P7_IS_VISIBLE,P7_DISPLAY_SEQ
                plsqlCode:
                    ```plsql
                    declare
                      l_id number;
                    begin
                      l_id := pck_hom_links_dml.save(
                                p_link_id         => to_number(:P7_LINK_ID),
                                p_title           => :P7_TITLE,
                                p_url             => :P7_URL,
                                p_description     => :P7_DESCRIPTION,
                                p_category_id     => to_number(:P7_CATEGORY_ID),
                                p_icon_id         => to_number(:P7_ICON_ID),
                                p_open_in_new_tab => :P7_OPEN_IN_NEW_TAB,
                                p_is_visible      => :P7_IS_VISIBLE,
                                p_display_seq     => to_number(:P7_DISPLAY_SEQ));
                      commit;
                    end;
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action go-back (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript
                    apex.navigation.redirect('f?p=&APP_ID.:6:&APP_SESSION.');
                    ```
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    dynamicAction da-delete (
        name: Delete link
        execution {
            sequence: 20
        }
        when {
            event: click
            selectionType: button
            button: @delete
        }

        action confirm-delete (
            action: confirm
            settings {
                message: Diesen Link wirklich löschen?
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action do-delete (
            action: executeServerSideCode
            settings {
                itemsToSubmit: P7_LINK_ID
                plsqlCode:
                    ```plsql
                    begin
                      pck_hom_links_dml.del(to_number(:P7_LINK_ID));
                      commit;
                    end;
                    ```
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action go-back-delete (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript
                    apex.navigation.redirect('f?p=&APP_ID.:6:&APP_SESSION.');
                    ```
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

    )

)
