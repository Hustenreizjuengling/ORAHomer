page 1 (
    name: Startseite
    alias: HOME
    title: ORAHomer
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region tiles (
        name: Anwendungen
        type: dynamicContent
        source {
            plsqlFunctionBody:
                ```plsql
                return pck_hom_api.render_home;
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

)
