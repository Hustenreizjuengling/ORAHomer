page 6 (
    name: Externe Links
    alias: LINKS
    title: ORAHomer - Externe Links
    pageGroup: @administration
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    button create (
        buttonName: CREATE
        label: Neuer Link
        layout {
            sequence: 1
            slot: body
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 7
                clearCache: 7
            }
        }
    )

    region links (
        name: Externe Links
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select l.link_id,
                       l.title,
                       l.url,
                       l.description,
                       c.name as category_name,
                       i.name as icon_name,
                       l.open_in_new_tab,
                       l.display_seq,
                       case l.is_visible when 'Y' then 'Sichtbar' else 'Versteckt' end as visible_label,
                       case l.is_visible when 'Y' then 'u-success' else 'u-warning' end as visible_css
                  from hom_links l
                  left join hom_categories c on c.category_id = l.category_id
                  left join hom_icons     i on i.icon_id     = l.icon_id
                 order by l.display_seq, l.title
                ```
        }
        layout {
            sequence: 10
            slot: body
            columnSpan: 12
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 7
                items: {
                    P7_LINK_ID: #LINK_ID#
                }
                clearCache: 7
            }
        }

        column LINK_ID (
            type: plainText
            heading {
                heading: ID
            }
            layout {
                sequence: 10
            }
            source {
                dataType: NUMBER
            }
        )
        column TITLE (
            type: plainText
            heading {
                heading: Titel
            }
            layout {
                sequence: 20
            }
            source {
                dataType: STRING
            }
        )
        column URL (
            type: plainText
            heading {
                heading: URL
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
        )
        column CATEGORY_NAME (
            type: plainText
            heading {
                heading: Kategorie
            }
            layout {
                sequence: 40
            }
            source {
                dataType: STRING
            }
        )
        column ICON_NAME (
            type: plainText
            heading {
                heading: Icon
            }
            layout {
                sequence: 50
            }
            source {
                dataType: STRING
            }
        )
        column OPEN_IN_NEW_TAB (
            type: plainText
            heading {
                heading: Neuer Tab
            }
            layout {
                sequence: 60
            }
            source {
                dataType: STRING
            }
        )
        column DISPLAY_SEQ (
            type: plainText
            heading {
                heading: Reihenfolge
            }
            layout {
                sequence: 70
            }
            source {
                dataType: NUMBER
            }
        )
        column VISIBLE_LABEL (
            type: plainText
            heading {
                heading: Sichtbarkeit
            }
            layout {
                sequence: 80
            }
            source {
                dataType: STRING
            }
            columnFormatting {
                htmlExpression: <span class="t-Badge &VISIBLE_CSS.">&VISIBLE_LABEL.</span>
            }
        )
        column VISIBLE_CSS (
            type: hidden
            heading {
                heading: Visible CSS
            }
            layout {
                sequence: 85
            }
            source {
                dataType: STRING
            }
        )
    )

)
